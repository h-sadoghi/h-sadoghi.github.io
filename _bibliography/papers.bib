  number = {5},
  numpages = {12},
  pages = {1878--1889},
  publisher = {Elsevier BV},
  title = {IRAHC: Instance Reduction Algorithm using Hyperrectangle Clustering},
  url = {https://doi.org/10.1016/j.patcog.2014.11.005},
  volume = {48},
